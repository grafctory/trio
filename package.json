{
  "name": "@metreeca/trio",
  "version": "0.1.2",
  "description": "RDF 1.1 data modelling, graph assembly and serialisation.",
  "keywords": [
    "typescript",
    "rdf",
    "linked-data",
    "semantic-web"
  ],
  "homepage": "https://metreeca.github.io/trio/",
  "bugs": {
    "url": "https://github.com/metreeca/trio/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/trio.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./builder": {
      "@metreeca/source": "./src/builder.ts",
      "default": "./dist/builder.js"
    },
    "./ntriples": {
      "@metreeca/source": "./src/ntriples/index.ts",
      "default": "./dist/ntriples/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ln",
    "build": "rm dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx wds --root-dir docs --watch --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.12.1"
  },
  "devDependencies": {
    "@metreeca/rack": "^0.4.0",
    "@types/node": "^26.1.1",
    "@web/dev-server": "^1.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
