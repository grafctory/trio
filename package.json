{
  "name": "@grafctory/trio",
  "version": "0.3.1",
  "description": "RDF 1.1 data modelling, graph assembly and serialisation.",
  "keywords": [
    "typescript",
    "rdf",
    "linked-data",
    "semantic-web"
  ],
  "homepage": "https://grafctory.github.io/trio/",
  "bugs": {
    "url": "https://github.com/grafctory/trio/issues",
    "email": "info@grafctory.dev"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/trio.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./builder": {
      "@grafctory/source": "./src/builder.ts",
      "default": "./dist/builder.js"
    },
    "./ntriples": {
      "@grafctory/source": "./src/codecs/ntriples/index.ts",
      "default": "./dist/codecs/ntriples/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ush ln",
    "build": "ush rm dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "ush up npx typedoc --watch + ush ws --open docs"
  },
  "dependencies": {
    "@grafctory/core": "^0.14.0"
  },
  "devDependencies": {
    "@grafctory/rack": "^0.8.0",
    "@types/node": "^26.1.1",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
